---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/photos/hero.jpg';
---

<Base>
  <main class="hero">
    <Image src={hero} alt="Silhouette éclairée par un projecteur sur une scène sombre" class="hero__photo" widths={[800, 1200, 2000]} sizes="100vw" loading="eager" />
    <div class="hero__content">
      <img src="/logo-light.svg" alt="" width="180" height="180" />
      <h1>Les boucher de Perthes</h1>
      <p>Troupe de théâtre</p>
      <p><a class="button" href="https://les-boucher-de-perthes.assoconnect.com/" rel="noopener">Réserver</a></p>
    </div>
  </main>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: hidden; }
  .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 75% center; }
  .hero__content { position: relative; padding: var(--gutter); max-width: 28rem; }
  @media (max-width: 700px) {
    .hero { align-items: end; }
    .hero__content { max-width: none; padding-top: 6rem; background: linear-gradient(0deg, var(--bg) 55%, transparent); }
  }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin: 0.5rem 0; }
</style>
