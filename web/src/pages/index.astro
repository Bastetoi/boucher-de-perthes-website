---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import HeroAccordion from '../components/HeroAccordion.astro';
import logo from '../assets/brand/logo-light.svg';
import hero from '../assets/photos/hero.jpg';
import { SITE, getEvents, getNews } from '../lib/site';

const { upcoming } = await getEvents();
const news = (await getNews()).slice(0, 3);
const next = upcoming[0];
---

<Base bare>
  <main>
    <section class="hero">
      <Image src={hero} alt="Comédienne assise au bord de la scène, de profil, éclairée par un projecteur dans le noir" class="hero__photo" widths={[800, 1200, 1333]} sizes="100vw" loading="eager" />
      <div class="hero__accordion"><HeroAccordion /></div>
      <div class="hero__content">
        <Image src={logo} alt="" width={180} height={180} loading="eager" />
        <h1>{SITE.name}</h1>
        <p>{SITE.tagline}</p>
        <p>
          {next
            ? <a class="button" href={next.data.ticketUrl} rel="noopener" target="_blank">Réserver</a>
            : <a class="button" href="/agenda">Voir l'agenda</a>}
        </p>
      </div>
    </section>

    <div class="container">
      <h2 class="section-title">Prochaines représentations</h2>
      {
        upcoming.length ? (
          upcoming.slice(0, 3).map((e) => <EventCard event={e} />)
        ) : (
          <p class="empty">Les prochaines dates seront annoncées bientôt. Suivez-nous sur nos réseaux pour ne rien manquer.</p>
        )
      }
      {upcoming.length > 3 && <p><a href="/agenda">Toutes les dates →</a></p>}

      <h2 class="section-title">Actualités</h2>
      {
        news.length ? (
          <ul class="news-list">
            {news.map((n) => <li><a href={n.data.url} rel="noopener" target="_blank">{n.data.title}</a></li>)}
          </ul>
        ) : (
          <p class="empty">Retrouvez toute notre actualité sur nos réseaux.</p>
        )
      }
      <SocialLinks />
    </div>
  </main>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: hidden; }
  .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .hero__content { position: relative; z-index: 2; padding: var(--gutter); max-width: 28rem; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin: 0.5rem 0; }
  .news-list { padding-left: 1.2rem; }
  .hero__accordion { display: none; }
  /* écran large (16:9 et plus) : titre à gauche, accordéon de photos à droite. Téléphone et tablette gardent la photo unique. */
  @media (min-aspect-ratio: 3/2) and (min-width: 701px) {
    .hero { height: 100svh; min-height: 0; background: #000; grid-template-columns: minmax(22rem, 30%) 1fr; }
    .hero__photo { display: none; }
    .hero__content { grid-column: 1; grid-row: 1; padding: var(--gutter) 3vw; max-width: none; }
    .hero__accordion { display: block; grid-column: 2; grid-row: 1; min-height: 0; height: 100%; }
    h1 { font-size: clamp(2.75rem, 4.5vw, 5.5rem); line-height: 0.95; }
  }
  @media (max-width: 700px) {
    /* mobile : texte en haut, photo dessous (le haut de la photo est noir, il se fond dans la page) */
    .hero { display: flex; flex-direction: column; align-items: stretch; background: #000; }
    .hero__content { max-width: none; padding-top: 8rem; padding-bottom: 0; order: -1; }
    .hero__content img { display: none; }
    .hero__photo { position: static; flex: 1; height: auto; min-height: 65svh; margin-top: -9rem; object-position: 80% 40%; mask-image: linear-gradient(180deg, transparent, #000 25%); }
  }
</style>
