---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const shows = (await getCollection('shows')).sort((a, b) => b.data.season - a.data.season);
---

<Base title="Spectacles" description="Les spectacles de la troupe.">
  <main class="page container" id="contenu">
    <h1>Spectacles</h1>
    {shows.length ? (
      <ul class="grid">
        {shows.map((s) => (
          <li>
            <a href={`/spectacles/${s.id}`}>
              {s.data.cover && <Image src={s.data.cover} alt="" widths={[400, 800]} sizes="(min-width: 700px) 30rem, 100vw" />}
              <h2>{s.data.title}</h2>
              <p>{s.data.summary}</p>
              <small>Saison {s.data.season}</small>
            </a>
          </li>
        ))}
      </ul>
    ) : <p class="empty">Aucun spectacle pour le moment.</p>}
  </main>
</Base>

<style>
  .grid { list-style: none; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .grid a { display: block; color: var(--text); text-decoration: none; height: 100%; }
  .grid h2 { font-size: 1.75rem; margin: 0.5rem 0 0; }
  .grid a:hover h2 { color: var(--accent); }
  .grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  small { color: var(--muted); }
</style>
