---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents } from '../../lib/site';

export async function getStaticPaths() {
  const shows = await getCollection('shows');
  return shows.map((show) => ({ params: { id: show.id }, props: { show } }));
}

const { show } = Astro.props;
const { Content } = await render(show);
const { upcoming, past } = await getEvents();
const dates = [...upcoming, ...past.slice().reverse()].filter((e) => e.data.show.id === show.id);
const { title, summary, author, director, cast, cover, gallery } = show.data;
---

<Base title={title} description={summary}>
  <main class="page container" id="contenu">
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    {cover && <Image src={cover} alt={`Photo du spectacle ${title}`} widths={[800, 1200, 1600]} sizes="(min-width: 60rem) 60rem, 100vw" loading="eager" />}
    <dl>
      {author && (<><dt>Texte</dt><dd>{author}</dd></>)}
      {director && (<><dt>Mise en scène</dt><dd>{director}</dd></>)}
      {cast.length > 0 && (<><dt>Distribution</dt><dd>{cast.join(', ')}</dd></>)}
    </dl>
    <Content />
    {
      gallery.length > 0 && (
        <>
          <h2 class="section-title">Galerie</h2>
          <ul class="gallery">
            {gallery.map((g) => (
              <li>
                <Image src={g.file} alt={g.alt} widths={[400, 800]} sizes="(min-width: 700px) 20rem, 50vw" />
                {g.credit && <small>© {g.credit}</small>}
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      dates.length > 0 && (
        <>
          <h2 class="section-title">Dates</h2>
          {dates.map((e) => <EventCard event={e} past={!upcoming.includes(e)} />)}
        </>
      )
    }
  </main>
</Base>

<style>
  img { max-width: 100%; height: auto; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1.5rem; }
  dt { color: var(--accent); }
  dd { margin: 0; }
  .gallery { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  small { color: var(--muted); }
</style>
