---
import { Image } from 'astro:assets';
import hero from '../assets/photos/hero.jpg';
import elfe from '../assets/photos/scene-elfe.jpg';
import violet from '../assets/photos/scene-violet.jpg';
import boite from '../assets/photos/scene-boite.jpg';
import publicImg from '../assets/photos/public.jpg';

// focus = object-position : garde le sujet visible quand le panneau est replié (étroit)
const panels = [
  { src: hero, alt: 'Comédienne assise au bord de la scène, de profil, sous un projecteur', focus: '62% 50%' },
  { src: elfe, alt: 'Personnage aux oreilles pointues, souriant, se retournant sur scène', focus: '31% 30%' },
  { src: violet, alt: 'Comédien sous une lumière violette, enfilant sa veste les yeux fermés', focus: '19% 20%' },
  { src: boite, alt: 'Comédienne assise sur une boîte, téléphone à l’oreille, dans un rai de lumière', focus: '57% 55%' },
  { src: publicImg, alt: 'Deux spectatrices éclatant de rire dans la salle', focus: '50% 40%' },
];
---

<ul class="accordion" data-accordion>
  {
    panels.map((p, i) => (
      <li class="panel" class:list={{ 'is-active': i === 0 }} tabindex="0">
        <Image src={p.src} alt={p.alt} widths={[400, 800, 1333]} sizes="50vw" style={`object-position: ${p.focus}`} loading={i === 0 ? 'eager' : 'lazy'} />
      </li>
    ))
  }
</ul>

<script>
  const acc = document.querySelector<HTMLElement>('[data-accordion]');
  if (acc) {
    const panels = [...acc.querySelectorAll<HTMLElement>('.panel')];
    let current = 0;
    let paused = false;
    const activate = (i: number) => {
      current = i;
      panels.forEach((p, j) => p.classList.toggle('is-active', j === i));
    };
    panels.forEach((p, i) => {
      p.addEventListener('mouseenter', () => activate(i));
      p.addEventListener('focus', () => activate(i));
    });
    acc.addEventListener('mouseenter', () => (paused = true));
    acc.addEventListener('mouseleave', () => (paused = false));
    // défilement automatique doux, sauf si le visiteur préfère moins d'animations
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => !paused && !acc.contains(document.activeElement) && activate((current + 1) % panels.length), 6000);
    }
  }
</script>

<style>
  .accordion { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; height: 100%; }
  .panel { position: relative; flex: 1; overflow: hidden; cursor: pointer; transition: flex 0.8s cubic-bezier(0.65, 0, 0.35, 1); }
  .panel.is-active { flex: 4; }
  .panel img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.5) contrast(1.15); transition: filter 0.8s ease; }
  .panel.is-active img { filter: none; }
  /* panneaux repliés : teinte bordeaux de la charte, qui unifie des photos très différentes */
  .panel::before { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--burgundy); mix-blend-mode: color; opacity: 0.85; box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.12); transition: opacity 0.8s ease; pointer-events: none; }
  .panel.is-active::before { opacity: 0; }
  /* liseré sur le panneau ouvert */
  .panel::after { content: ''; position: absolute; z-index: 2; inset: auto 0 0 0; height: 4px; background: var(--accent); transform: scaleX(0); transition: transform 0.8s ease; }
  .panel.is-active::after { transform: scaleX(1); }
  .panel:focus-visible { outline: 3px solid var(--text); outline-offset: -3px; }
  @media (prefers-reduced-motion: reduce) { .panel, .panel img, .panel::after, .panel::before { transition: none; } }
</style>
